{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataFolderPath": "../../data",
  "EnableRag": false,
  // "SqlServer" (shared, central — the deployment default) or "Sqlite" (local file, nothing to install).
  "DatabaseProvider": "SqlServer",
  // Which LLM answers questions: "Anthropic" or "OpenAI".
  // Back-office systems shown in the "Sources" dropdown. Give a system its ConnectionString
  // (and/or Tables) once it is wired up; until then it is listed as "not connected yet".
  "Sources": {
    "Systems": [
      { "Id": "hr", "Name": "نظام الموارد البشرية", "ConnectionString": "" },
      { "Id": "finance", "Name": "نظام المالية", "ConnectionString": "" },
      { "Id": "procurement", "Name": "نظام المشتريات", "ConnectionString": "" }
    ]
  },
  "Llm": {
    "Provider": "Anthropic"
  },
  "OpenAI": {
    "Model": "gpt-4o"
  },
  "Anthropic": {
    "Model": "claude-sonnet-5",
    "MaxTokens": 16000
  },
  "ConnectionStrings": {
    "DataDb": ""
  }
}
