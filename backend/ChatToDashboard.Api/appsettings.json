{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataFolderPath": "../../data",
  "EnableRag": false,
  // "SqlServer" (shared, central — the deployment default) or "Sqlite" (local file, nothing to install).
  "DatabaseProvider": "SqlServer",
  // Which LLM answers questions: "Anthropic" or "OpenAI".
  // Back-office systems shown in the "Sources" dropdown. Give a system its ConnectionString
  // (and/or Tables) once it is wired up; until then it is listed as "not connected yet".
  "Sources": {
    "Systems": [
      { "Id": "hr", "Name": "نظام الموارد البشرية", "ConnectionString": "" },
      { "Id": "finance", "Name": "نظام المالية", "ConnectionString": "" },
      { "Id": "procurement", "Name": "نظام المشتريات", "ConnectionString": "" }
    ]
  },
  // Price per MILLION tokens, used to estimate cost on the /usage page. Anthropic list
  // prices are prefilled; fill in your own OpenAI rates from platform.openai.com/pricing.
  // CacheRead/CacheWrite default to 10% / 125% of Input when omitted.
  "Pricing": {
    "Models": {
      "claude-opus-5": { "Input": 5, "Output": 25 },
      "claude-sonnet-5": { "Input": 2, "Output": 10 },
      "claude-sonnet-4-6": { "Input": 3, "Output": 15 },
      "claude-haiku-4-5": { "Input": 1, "Output": 5 },
      "gpt-4o": { "Input": 0, "Output": 0 }
    }
  },
  "Llm": {
    "Provider": "Anthropic"
  },
  "OpenAI": {
    "Model": "gpt-4o"
  },
  "Anthropic": {
    "Model": "claude-sonnet-5",
    "MaxTokens": 16000
  },
  "ConnectionStrings": {
    "DataDb": ""
  }
}
