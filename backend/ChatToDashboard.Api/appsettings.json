{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataFolderPath": "../../data",
  "EnableRag": false,
  // "SqlServer" (shared, central — the deployment default) or "Sqlite" (local file, nothing to install).
  "DatabaseProvider": "SqlServer",
  "Anthropic": {
    "Model": "claude-sonnet-5",
    "MaxTokens": 16000
  },
  "ConnectionStrings": {
    "DataDb": ""
  }
}
