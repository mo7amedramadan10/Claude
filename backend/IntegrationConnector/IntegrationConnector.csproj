<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Both drivers are always referenced — TargetDbProvider (below) picks which one is
         actually used at runtime, so the same build works whether the client's live database
         is SQL Server or SQLite, without them needing to touch this project's code. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.30" />
    <PackageReference Include="Dapper" Version="2.1.66" />
  </ItemGroup>

</Project>
